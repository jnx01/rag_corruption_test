# Copy this file to ".env" and paste your real API key there.
# The ".env" file is gitignored, so your key will never be committed.

# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Get a free key from Groq: https://console.groq.com/keys
GROQ_API_KEY=paste-your-key-here

# Which provider to use: "groq" or "gemini"
LLM_PROVIDER=groq
